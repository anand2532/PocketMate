(version 1)
# Impedance geometry: JLC06161H-3313, JLC impedance calculator results (finished 1.54 mm), rounded; L3 100R 0.106/0.18 JLC-verified
(rule "MIPI 100R outer" (condition "A.NetClass == 'MIPI_100R' && (A.Layer == 'F.Cu' || A.Layer == 'B.Cu')")
  (constraint track_width (min 0.1mm) (opt 0.105mm) (max 0.11mm)) (constraint diff_pair_gap (min 0.14mm) (opt 0.15mm) (max 0.16mm)) (constraint diff_pair_uncoupled (max 3mm)))
(rule "MIPI 100R L3" (condition "A.NetClass == 'MIPI_100R' && A.Layer == 'In2.Cu'")
  (constraint track_width (min 0.101mm) (opt 0.106mm) (max 0.111mm)) (constraint diff_pair_gap (min 0.17mm) (opt 0.18mm) (max 0.19mm)))
(rule "MIPI not on L4/L5/L2" (condition "A.NetClass == 'MIPI_100R' && (A.Layer == 'In1.Cu' || A.Layer == 'In3.Cu' || A.Layer == 'In4.Cu')") (constraint disallow track))
(rule "USB 90R outer" (condition "A.NetClass == 'USB_90R' && (A.Layer == 'F.Cu' || A.Layer == 'B.Cu')")
  (constraint track_width (min 0.13mm) (opt 0.135mm) (max 0.14mm)) (constraint diff_pair_gap (min 0.14mm) (opt 0.15mm) (max 0.16mm)))
(rule "USB 90R L3" (condition "A.NetClass == 'USB_90R' && A.Layer == 'In2.Cu'")
  (constraint track_width (min 0.123mm) (opt 0.128mm) (max 0.133mm)) (constraint diff_pair_gap (min 0.14mm) (opt 0.15mm) (max 0.16mm)))
(rule "SE 50R outer" (condition "A.NetClass == 'SE_50R' && (A.Layer == 'F.Cu' || A.Layer == 'B.Cu')") (constraint track_width (min 0.145mm) (opt 0.15mm) (max 0.155mm)))
(rule "SE 50R L3" (condition "A.NetClass == 'SE_50R' && A.Layer == 'In2.Cu'") (constraint track_width (min 0.137mm) (opt 0.142mm) (max 0.147mm)))
(rule "MIPI skew" (condition "A.NetClass == 'MIPI_100R'") (constraint skew (max 0.1mm)))
(rule "USB skew" (condition "A.NetClass == 'USB_90R'") (constraint skew (max 3.8mm)))
(rule "USB-C J6 shell at board edge" (condition "A.Parent == 'J6'") (constraint edge_clearance (min 0.2mm)))
(rule "U12 SOT-563 fine-pitch pads" (condition "A.Parent == 'U12' && B.Parent == 'U12'") (constraint clearance (min 0.15mm)))
# --- Power copper (netlist v3.2 brief) ---
(rule "VBAT pour/track" (condition "A.NetName == 'VBAT'") (constraint track_width (min 1.0mm) (opt 3.0mm)) (constraint via_diameter (min 0.6mm)) (constraint hole_size (min 0.3mm)))
(rule "BAT_N" (condition "A.NetName == '/PowerInput/BAT_N'") (constraint track_width (min 1.0mm) (opt 3.0mm)))
(rule "VBUS VSYS PMID" (condition "A.NetName == '/PowerInput/VBUS_C' || A.NetName == '/PowerInput/VBUS_CHG' || A.NetName == 'VSYS' || A.NetName == '/PowerInput/CHG_PMID' || A.NetName == '/Regulators/+5V_BOOST'") (constraint track_width (min 1.5mm) (opt 2.0mm)))
(rule "Switch nodes" (condition "A.NetName == '/PowerInput/CHG_SW' || A.NetName == '/Regulators/BST_SW' || A.NetName == '/Regulators/BUCK3V3_SW'") (constraint track_width (min 1.5mm) (opt 2.0mm)))
