# PocketMate read-only rootfs (§2). The active slot's root is selected by cmdline.txt in boot-A/boot-B.
proc                              /proc            proc   defaults                         0 0
tmpfs                             /tmp             tmpfs  nosuid,nodev,mode=1777,size=128M  0 0
tmpfs                             /var/tmp         tmpfs  nosuid,nodev,mode=1777,size=64M   0 0
/dev/mapper/pmdata                /data            ext4   noatime,nosuid,nodev,x-systemd.device-timeout=30s 0 2
/data/pm                          /var/lib/pm      none   bind,x-systemd.requires-mounts-for=/data 0 0
/data/log                         /var/log         none   bind,x-systemd.requires-mounts-for=/data 0 0
/data/nm                          /var/lib/NetworkManager none bind,x-systemd.requires-mounts-for=/data 0 0
/data/nm-connections              /etc/NetworkManager/system-connections none bind,x-systemd.requires-mounts-for=/data 0 0
# /boot/firmware and /opt/pm/models depend on the slot: generated by pm-slot-generator from pm.slot= on the
# kernel cmdline (cmdline.txt in boot-A says pm.slot=A, boot-B says pm.slot=B).
