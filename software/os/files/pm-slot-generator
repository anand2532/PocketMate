#!/bin/bash
# systemd generator (/usr/lib/systemd/system-generators/pm-slot-generator): mounts for the booted A/B slot.
#   $1 = normal generator dir. Reads pm.slot=A|B from /proc/cmdline (PM_CMDLINE for tests).
set -eu
out="${1:-/run/systemd/generator}"
cmdline="${PM_CMDLINE:-$(cat /proc/cmdline)}"
slot=A
for w in $cmdline; do case "$w" in pm.slot=A|pm.slot=B) slot="${w#pm.slot=}" ;; esac; done
mkdir -p "$out/local-fs.target.wants"
unit() {  # unit <where> <what> <type> <options>
    local name; name="$(printf '%s' "${1#/}" | tr / -).mount"
    cat > "$out/$name" <<UNIT
# generated by pm-slot-generator (slot $slot)
[Unit]
Before=local-fs.target
[Mount]
What=$2
Where=$1
Type=$3
Options=$4
UNIT
    ln -sf "../$name" "$out/local-fs.target.wants/$name"
}
unit /boot/firmware "/dev/disk/by-partlabel/boot-$slot" vfat ro,nosuid,nodev,noexec
unit /opt/pm/models "/dev/disk/by-partlabel/models-$slot" ext4 ro,noatime,nosuid,nodev
