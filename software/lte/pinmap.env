# PocketMate LTE board control lines: CM5 GPIO (BCM numbering on RP1), from hardware/kicad/PocketMate.net
# and hardware/kicad-lte (2026-10-27). Checked by check_netlist.py. Sourced by pm-lte-power.
# Electrical sense (LTE board "Control" sheet):
#   PWR_EN   high = TPS22965 load switch on (100k pull-down, RP1 reset pull-down)
#   PWRKEY   high = NMOS pulls module PWRKEY low (i.e. "pressed")
#   RESET    high = NMOS pulls module RESET_N low (reset asserted)
#   STATUS   INVERTED: low = module on, high = off/unpowered (Q3 inverter, 10k to CM5_3V3)
#   RI       module ring/URC indicator; idle high, pulses low (wake source)  VERIFY pulse polarity
#   AP_READY CM5 -> module "host ready" (level-shifted open drain)              VERIFY polarity per AT+QCFG="apready"
#   W_DISABLE_N low = RF disabled (owned by rfkill-gpio "pocketmate-wwan" when dtoverlay ...,lte is set)
LTE_PWR_EN_GPIO=24
LTE_PWRKEY_GPIO=9
LTE_RESET_GPIO=13
LTE_STATUS_GPIO=16
LTE_RI_GPIO=12
LTE_AP_READY_GPIO=25
LTE_W_DISABLE_N_GPIO=26
