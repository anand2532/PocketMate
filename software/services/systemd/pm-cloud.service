# PocketMate pm-cloud — generated for ARCHITECTURE.md §5.2 [impl v0.4.0]
[Unit]
# /var/lib/pm is the LUKS2 data partition (ARCHITECTURE.md §2.1)
RequiresMountsFor=/var/lib/pm
Description=PocketMate optional cloud adapters (egress gated by consent token)
PartOf=pocketmate.target
After=pm-core.service network-online.target
Wants=pm-core.service network-online.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/pm-cloud --db /var/lib/pm/memory.db
User=pm-cloud
Group=pm-cloud
SupplementaryGroups=pm
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/pocketmate
RuntimeDirectory=pm
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0770
WatchdogSec=30
Restart=on-failure
RestartSec=2
MemoryMax=60M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0007
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/pm
ReadOnlyPaths=/var/lib/pm/secrets
# Only service with general egress: nftables (os/files/nftables-pm.conf) allows meta skuid pm-cloud.
# Exits immediately (status 0) when [cloud] enabled = false in settings.toml (the default).
SuccessExitStatus=0
Restart=on-abnormal

[Install]
WantedBy=pocketmate.target
