# llama.cpp llama-server on a Unix socket (§5.2 pm-llm) [impl v0.4.0]
# Binary path and flags are VERIFY on hardware (llama.cpp build for aarch64 is part of the image, os/stage-pm).
[Unit]
Description=PocketMate local LLM (llama-server)
PartOf=pocketmate.target
After=pm-profile.service
ConditionPathExists=/opt/pm/models/llm.gguf

[Service]
Type=simple
User=pm-llm
Group=pm-llm
SupplementaryGroups=pm
RuntimeDirectory=pm
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/llama-server --model /opt/pm/models/llm.gguf --host /run/pm/llm.sock --ctx-size 4096 --threads 4 --mlock=false
Restart=on-failure
MemoryMax=2600M
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/opt/pm/models
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
UMask=0007

[Install]
WantedBy=pocketmate.target
